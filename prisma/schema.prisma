datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CONTRACTOR
  APPROVER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskType {
  ERROR
  FEATURE
  IDEA
}

// Legacy single-track status, kept only as read-only history on tasks
// created before 2026-08-17 -- no longer written by any action. See
// Stage/StageStatus below for the flow that replaced it.
enum Status {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  STAGING_REVIEW
  APPROVED
  DONE
}

// Replaces Status as of 2026-08-17. Two independent axes instead of one
// linear pipeline -- any user with edit access can set either directly,
// in any combination, at any time. No gated approve/reject step anymore.
enum Stage {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum StageStatus {
  OPEN
  IN_PROGRESS
  CHANGES_REQUESTED
  COMPLETE
}

// The single task pipeline that replaces Stage + StageStatus (2026-08-27).
// One ordered track; the board's columns map 1:1 onto these values. Any
// logged-in user can still set it directly -- the guided buttons (Send for
// review / Approve / Send back / Mark deployed) are conveniences on top,
// not gates. `stage`/`stageStatus`/`status` are kept on Task for now,
// populated in parallel by the old UI, and dropped in the final cleanup
// pass once nothing reads them.
enum Pipeline {
  BACKLOG // created, not started
  IN_PROGRESS // a developer is working on it
  IN_REVIEW // dev says it's done -- on the tester/approver's plate
  READY_TO_DEPLOY // approved -- on Yasir's plate to deploy or add to a build
  DEPLOYED // live in production, or shipped in an app build
}

// Per app area: how finished work in it reaches production. CONTINUOUS =
// deployed directly (bubld.com, bublr.bubld.com, Admin Panel,
// Infrastructure, Tasks Tool). BUILD = batched into a numbered app-store
// build (Customer App, Technician App).
enum ReleaseMode {
  CONTINUOUS
  BUILD
}

model User {
  id                        String       @id @default(cuid())
  name                      String
  email                     String       @unique
  passwordHash              String
  role                      Role
  isActive                  Boolean      @default(true)
  emailNotificationsEnabled Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  // Last time this user viewed their "since you were last here" digest --
  // not a generic last-request timestamp. Drives what counts as new on
  // their next login. Null until their first digest view.
  lastSeenAt                DateTime?
  createdTasks              Task[]       @relation("CreatedBy")
  assignedTasks             Task[]       @relation("AssignedTo")
  comments                  Comment[]
  attachments               Attachment[]
  loginAttempts             LoginAttempt[]
  activityLogs              ActivityLog[]
}

// Admin-managed list (was a fixed enum) so Yasir can add/retire app areas
// without a code change. Removal is a soft-disable (isActive: false) --
// it disappears from the "new task" picker but tasks that already
// reference it keep displaying it normally, matching the same
// disable-don't-delete pattern already used for User.
model AppArea {
  id          String      @id @default(cuid())
  name        String      @unique
  isActive    Boolean     @default(true)
  // How work in this area ships -- drives which action the "Ready to
  // deploy" step offers (mark deployed vs. add to next build). Admin-set
  // in Settings.
  releaseMode ReleaseMode @default(CONTINUOUS)
  createdAt   DateTime    @default(now())
  tasks       Task[]
}

// A shippable batch of tasks. Exactly one Build should ever have
// shippedAt: null at a time -- that's "the next build" everyone tags
// tasks onto. Shipping it (setting shippedAt) archives it as permanent
// history; the next task tagged after that lazily creates a fresh one
// (see getOrCreateOpenBuild in actions.ts).
model Build {
  id        String    @id @default(cuid())
  number    Int       @unique
  shippedAt DateTime?
  createdAt DateTime  @default(now())
  tasks     Task[]
}

model Task {
  id                String       @id @default(cuid())
  number            Int          @unique
  title             String
  description       String
  appArea           AppArea      @relation(fields: [appAreaId], references: [id])
  appAreaId         String
  dueDate           DateTime?
  priority          Priority
  type              TaskType
  // --- Legacy status model. Still written by the current UI and read by
  // it until the new board replaces those screens; dropped in the final
  // cleanup pass. New code reads `pipeline`/`archived` below instead. ---
  status            Status       @default(OPEN)
  stage             Stage        @default(DEVELOPMENT)
  stageStatus       StageStatus  @default(OPEN)
  closed            Boolean      @default(false)
  closedAt          DateTime?

  // --- Single-pipeline model (2026-08-27). Populated from stage +
  // stageStatus by migration 20260827_add_task_pipeline. ---
  pipeline          Pipeline     @default(BACKLOG)
  // Replaces `closed` -- a task everyone has seen shipped, off the board
  // but still searchable. Independent of pipeline position.
  archived          Boolean      @default(false)
  archivedAt        DateTime?
  // Set when a reviewer sends a task back for changes; cleared when it is
  // sent for review again.
  changesRequested  Boolean      @default(false)
  build             Build?       @relation(fields: [buildId], references: [id])
  buildId           String?
  foundInProduction Boolean      @default(false)
  isDraft           Boolean      @default(false)
  // Legacy field, no longer written -- history from the old approve/reject
  // flow only.
  reviewNote        String?
  // Free text, one commit per line, chronological (oldest first) --
  // recommended form "repo: hash -- what it did", so a reader can act on
  // it directly (know which repo to look in) without reading the private
  // notes first. Concrete evidence backing a Staging Review/Complete
  // status, not just a claim.
  commits           String?
  // Hours Shahzad/Techaliance quoted for the work, and who signed off on
  // that budget (Yasir or Roland) -- free text name, not a User relation,
  // since it's recording a budget decision, not assigning the task.
  // Visible to everyone; only ADMIN/APPROVER can set it (see updateTaskQuote).
  quotedHours       Float?
  approvedBy        String?
  // Claude's own pass over a task (flag + a comprehensive note on what was
  // checked/found), set when Yasir asks for a review sweep -- separate from
  // the real STAGING_REVIEW workflow, which Roland/Danielle still drive
  // normally. Yasir still makes his own approve/disapprove/reject call
  // through the existing status controls; this is just a heads-up for him
  // beforehand. ADMIN-only, same enforcement pattern as commits.
  autoReviewed      Boolean      @default(false)
  autoReviewNote    String?
  createdBy         User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdById       String
  assignee          User?        @relation("AssignedTo", fields: [assigneeId], references: [id])
  assigneeId        String?
  comments          Comment[]
  attachments       Attachment[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([stage])
  @@index([stageStatus])
  @@index([closed])
  @@index([pipeline])
  @@index([archived])
  @@index([assigneeId])
  @@index([createdById])
  @@index([appAreaId])
  @@index([buildId])
}

model Comment {
  id          String       @id @default(cuid())
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  author      User         @relation(fields: [authorId], references: [id])
  authorId    String
  body        String
  // ADMIN-only: a private technical note (commit refs, file paths, etc.)
  // visible to Yasir alone -- everyone else must never see it, enforced
  // in the query layer (lib/tasks.ts), same pattern as draft tasks.
  isPrivate   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([taskId])
}

model Attachment {
  id           String   @id @default(cuid())
  key          String   // S3 object key, not a public URL -- resolved to a presigned URL on read
  filename     String
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String?
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId    String?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([commentId])
}

// Structured, queryable record of every task mutation -- separate from
// Comment on purpose. Comments are for human discussion (and cascade-delete
// with their task); this is for "who did what, and when" and needs to
// survive a task being deleted and be filterable by field, not just prose.
// taskId is intentionally not a real relation (no cascade) -- it goes
// stale/unlinkable once a task is deleted, but taskNumber/taskTitle are
// snapshotted here so the entry still reads fine. taskCreatedById/
// taskAssigneeId are also snapshotted at write time (not a live join to
// Task) so "activity relevant to me" stays correct even after the task
// referenced no longer exists or its assignee has since changed.
model ActivityLog {
  id              String   @id @default(cuid())
  actor           User     @relation(fields: [actorId], references: [id])
  actorId         String
  // "created" | "edited" | "assigned" | "stage_changed" |
  // "stage_status_changed" | "closed" | "reopened" | "deleted" |
  // "published" | "commented" | "quote_updated" | "build_tagged" |
  // "build_untagged"
  action          String
  taskId          String?
  taskNumber      Int
  taskTitle       String
  taskCreatedById String
  taskAssigneeId  String?
  field           String?
  oldValue        String?
  newValue        String?
  // Mirrors Comment.isPrivate for action: "commented" -- a private note's
  // ActivityLog entry must be just as invisible to non-admins as the
  // comment itself. Always false for every other action.
  isPrivate       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([taskCreatedById])
  @@index([taskAssigneeId])
  @@index([actorId])
}

// Simple sliding-window login rate limiting -- no external service needed.
model LoginAttempt {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
